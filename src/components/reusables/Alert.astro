---
import Icon from 'astro-iconify-component';

interface Props {
  type?: 'success' | 'info' | 'warning' | 'error' | 'link' | 'neutral';
  icon?: 'success' | 'info' | 'warning' | 'error' | 'link' | 'neutral';
  noicon?: boolean;
  noborder?: boolean;
}

const { type = 'info', icon: iconOverride, noicon = false, noborder = false } = Astro.props;

const typeMap = {
  success: {
    base: 'bg-clampography-success/5',
    text: 'text-clampography-success',
    border: 'border-clampography-success border-[1px]',
    icon: 'clarity:success-standard-solid',
  },
  info: {
    base: 'bg-clampography-info/5',
    text: 'text-clampography-info',
    border: 'border-clampography-info border-[1px]',
    icon: 'clarity:info-solid',
  },
  warning: {
    base: 'bg-clampography-warning/5',
    text: 'text-clampography-warning',
    border: 'border-clampography-warning border-[1px]',
    icon: 'clarity:warning-solid',
  },
  error: {
    base: 'bg-clampography-error/5',
    text: 'text-clampography-error',
    border: 'border-clampography-error border-[1px]',
    icon: 'clarity:error-solid',
  },
  link: {
    base: 'bg-clampography-info/5',
    text: 'text-clampography-info',
    border: 'border-clampography-info border-[1px]',
    icon: 'mdi:link-variant',
  },
  neutral: {
    base: 'bg-clampography-surface',
    text: 'text-clampography-text',
    border: 'border-clampography-text border-[1px]',
    icon: 'mdi:android-messages',
  },
};

const borderClass = noborder ? 'border-0' : typeMap[type].border;
const alertClass = `${typeMap[type].base} ${typeMap[type].text} ${borderClass} flex w-full items-center gap-3 my-4 p-(--clampography-spacing-sm) rounded-xl [&_strong]:!text-inherit [&_a]:!text-inherit [&_a]:![text-decoration-color:color-mix(in_oklab,currentcolor_30%,transparent)] [&_a:hover]:!decoration-current`;
const icon = iconOverride ? typeMap[iconOverride].icon : typeMap[type].icon;
---

<div role='alert' class={alertClass}>
  {
    !noicon && (
      <span class='flex shrink-0 items-center'>
        <Icon name={icon} class='size-[2em]' />
      </span>
    )
  }
  <span class='w-full'>
    <slot />
  </span>
</div>
