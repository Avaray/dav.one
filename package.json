{
    "name": "dav.one",
    "type": "module",
    "version": "2.2.0",
    "scripts": {
        "dev": "astro dev",
        "dev:prod": "PRODUCTION_BUILD=true astro dev",
        "dev:prod:host": "PRODUCTION_BUILD=true astro dev --host 0.0.0.0",
        "clear": "astro dev --clear-cache",
        "serve": "astro dev --host 0.0.0.0",
        "generate-og": "node --experimental-strip-types src/scripts/generate-og-images.ts",
        "build": "bun run src/scripts/update-icons.ts && bun run generate-og && astro build",
        "preview": "astro preview",
        "taze": "bunx taze latest"
    },
    "dependencies": {
        "@astrojs/mdx": "^8.1.6",
        "@astrojs/react": "^7.1.9",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.5",
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "astro": "^7.4.12",
        "astro-iconify-component": "^0.1.0-beta.4",
        "clampography": "^2.1.1",
        "marked": "^18.2.0",
        "playwright": "^1.65.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.5",
        "unist-util-visit": "^5.2.0"
    },
    "devDependencies": {
        "@swc/html": "^1.16.22",
        "asciinema-player": "^3.18.0",
        "daisyui": "^5.8.0",
        "vite-plugin-qrcode": "^0.4.1"
    }
}
